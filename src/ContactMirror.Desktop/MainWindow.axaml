<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ContactMirror.Desktop" x:Class="ContactMirror.Desktop.MainWindow"
  Title="ContactMirror" Width="1180" Height="820" MinWidth="820" MinHeight="640" AutomationProperties.AutomationId="ContactMirrorWindow">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,20">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel><TextBlock Text="ContactMirror" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Ваши контакты — в Google и в вашей папке" Classes="caption" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Что поддерживается" Command="{Binding ToggleCapabilitiesCommand}" AutomationProperties.AutomationId="CapabilitiesButton"/>
        <Button Content="Настройки" Command="{Binding ToggleSettingsCommand}" AutomationProperties.AutomationId="SettingsButton"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,16">
      <Border IsVisible="{Binding IsDemo}" Background="#FFF0C2" CornerRadius="8" Padding="12"><TextBlock Text="Демонстрационный режим · вымышленные контакты · Google не подключается" Foreground="#644B00" TextWrapping="Wrap" AutomationProperties.AutomationId="DemoNotice"/></Border>
      <Border IsVisible="{Binding HasError}" Background="#FFF0F0" CornerRadius="8" Padding="12"><TextBlock Text="{Binding Error}" Foreground="#A52929" TextWrapping="Wrap" AutomationProperties.AutomationId="ErrorText" AutomationProperties.Name="{Binding Error}"/></Border>
      <Border Classes="card" IsVisible="{Binding ShowSettings}">
        <ScrollViewer MaxHeight="350"><StackPanel Spacing="10"><TextBlock Text="Настройки приложения" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ConfigurationHint}" Classes="caption"/>
          <TextBlock Text="Обновления" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat='Установленная версия {0}'}" AutomationProperties.AutomationId="AppVersionText"/>
          <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateStatusText"/>
          <TextBlock Text="{Binding Updates.Error}" IsVisible="{Binding Updates.HasError}" TextWrapping="Wrap" Foreground="#A52929" AutomationProperties.AutomationId="UpdateErrorText"/>
          <ProgressBar Value="{Binding Updates.Progress}" Maximum="100" IsVisible="{Binding Updates.IsDownloading}" AutomationProperties.AutomationId="UpdateProgress" Height="6"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Updates.IsChecking}" Height="4"/>
          <WrapPanel>
            <Button Content="Проверить обновления" Command="{Binding Updates.CheckCommand}" AutomationProperties.AutomationId="CheckUpdatesButton" Margin="0,0,8,8"/>
            <Button Content="Скачать" Command="{Binding Updates.DownloadCommand}" AutomationProperties.AutomationId="DownloadUpdateButton" Margin="0,0,8,8"/>
            <Button Content="Установить и перезапустить" Command="{Binding Updates.RestartCommand}" IsVisible="{Binding Updates.IsReady}" AutomationProperties.AutomationId="RestartUpdateButton" Margin="0,0,8,8"/>
            <Button Content="Остановить загрузку" Command="{Binding Updates.CancelCommand}" IsVisible="{Binding Updates.IsDownloading}" AutomationProperties.AutomationId="CancelUpdateButton" Margin="0,0,8,8"/>
          </WrapPanel>
          <Expander Header="Параметры Google и тема" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
          <WrapPanel><Button Content="Войти снова" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,8"/><Button Content="Выбрать OAuth-конфигурацию…" Click="ChooseOAuth" IsEnabled="{Binding CanOverrideOAuth}" AutomationProperties.AutomationId="OAuthConfigButton" Margin="0,0,8,8"/><Button Content="Отключить аккаунт" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Margin="0,0,8,8"/><TextBlock Text="Тема" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox SelectedIndex="0" SelectionChanged="ThemeChanged" Width="170"><ComboBoxItem Content="Как в системе"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox></WrapPanel>
          <TextBlock Text="Разрешение хранится в защищённом хранилище Windows. Отключение удаляет локальный токен; доступ можно отозвать в настройках Google." Classes="caption"/>
          <Button Content="Использовать подключение издателя" Click="UsePublisherOAuth" IsEnabled="{Binding CanOverrideOAuth}" HorizontalAlignment="Left" AutomationProperties.AutomationId="PublisherOAuthButton"/>
          <Separator Margin="0,8"/>
            </StackPanel>
          </Expander>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowCapabilities}"><StackPanel Spacing="8">
        <TextBlock Text="Какие данные синхронизируются" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Все поля, доступные People API: имена, телефоны, почта, адреса, даты, ссылки, организации, профессии, отношения, заметки, пользовательские поля и остальные категории. Значения сохраняются полностью в JSON." TextWrapping="Wrap"/>
        <TextBlock Text="Фото, пользовательские ярлыки и избранное поддерживаются отдельными операциями. Метаданные и данные профиля сохраняются для чтения. Неизвестное поле блокирует запись затронутой категории и объясняет причину." TextWrapping="Wrap"/>
        <TextBlock Text="Синхронизируются сохранённые контакты. «Другие контакты», корпоративный каталог и корзина Google в эту папку не входят. Точная карта возможностей приведена ниже." Classes="caption"/>
        <ScrollViewer MaxHeight="160"><ItemsControl ItemsSource="{Binding Capabilities}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,*" Margin="0,4"><TextBlock Text="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding Mode}" Classes="caption"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </StackPanel></Border>
    </StackPanel>
    <Grid Grid.Row="2">
      <ScrollViewer IsVisible="{Binding IsOnboarding}"><StackPanel MaxWidth="750" HorizontalAlignment="Center" Spacing="18" Margin="0,24,0,24">
        <TextBlock Text="Адресная книга, которой вы управляете" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Сохраните контакты обычными файлами. Правьте их в любимом редакторе и отправляйте изменения обратно в Google — с предварительным просмотром." FontSize="16" Classes="caption"/>
        <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="1  Подключите Google" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Вход откроется в браузере. Пароль приложение не получает." Classes="caption"/><Button HorizontalAlignment="Left" Classes="primary" Content="Подключить Google" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConfigure}" AutomationProperties.AutomationId="ConnectGoogleButton"/><TextBlock Text="{Binding ConfigurationHint}" Classes="caption"/></StackPanel></Border>
        <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="2  Выберите папку" FontSize="20" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto"><TextBox IsEnabled="{Binding CanConfigure}" Text="{Binding Folder}" PlaceholderText="Папка для файлов контактов" AutomationProperties.AutomationId="FolderInput"/><Button Grid.Column="1" Content="Выбрать…" Click="ChooseFolder" IsEnabled="{Binding CanConfigure}" Margin="10,0,0,0" AutomationProperties.AutomationId="ChooseFolderButton"/></Grid><TextBlock Text="Один JSON-файл на контакт, фотографии рядом. Здесь же будут резервные копии. Синхронизируются сохранённые контакты, фото и ярлыки." Classes="caption"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid IsVisible="{Binding IsConnected}" IsEnabled="{Binding !ShowDeleteConfirmation}" RowDefinitions="Auto,Auto,*,Auto">
        <Border Classes="card" Padding="16" Margin="0,0,0,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding AccountLabel}" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="AccountLabel" AutomationProperties.Name="{Binding AccountLabel}"/><TextBlock Text="{Binding Folder}" Classes="caption" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastRun}" Classes="caption" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Папка" Command="{Binding OpenFolderCommand}"/><Button Content="Выбрать…" Click="ChooseFolder" IsEnabled="{Binding CanConfigure}"/><Button Content="История" Command="{Binding ToggleHistoryCommand}" AutomationProperties.AutomationId="HistoryButton"/></StackPanel></Grid></Border>
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,12"><WrapPanel><Button Content="Проверить изменения" Classes="primary" Command="{Binding CheckCommand}" AutomationProperties.AutomationId="CheckChangesButton" Margin="0,0,10,0"/><Button Content="Новый файл контакта" Command="{Binding NewContactCommand}" AutomationProperties.AutomationId="NewContactButton" Margin="0,0,10,0"/><Button Content="Разобрать конфликты" Command="{Binding NextConflictCommand}" AutomationProperties.AutomationId="NextConflictButton"/></WrapPanel><TextBlock Text="{Binding Counts}" FontWeight="SemiBold" AutomationProperties.AutomationId="PlanSummaryText" AutomationProperties.Name="{Binding Counts}"/><Grid ColumnDefinitions="Auto,*"><ComboBox ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" Width="230" AutomationProperties.AutomationId="FilterInput"/><TextBox Grid.Column="1" Text="{Binding Search}" PlaceholderText="Поиск по имени или полю" Margin="12,0,0,0" AutomationProperties.AutomationId="SearchInput"/></Grid></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="0.9*,14,1.1*" IsVisible="{Binding !ShowHistory}">
          <Border Classes="card" Padding="0"><ListBox ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}" AutomationProperties.AutomationId="ChangesList"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:EntryViewModel"><Grid ColumnDefinitions="Auto,*" Margin="6,8"><CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.AutomationId="{Binding Entry.Key}" IsEnabled="{Binding Entry.IsSelectable}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Entry.Name}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Direction}" TextWrapping="Wrap"/><TextBlock Text="{Binding FieldLabel}" Classes="caption" FontSize="12"/><TextBlock Text="{Binding ResolutionLabel}" FontSize="12" Foreground="#315DDC"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
          <Border Grid.Column="2" Classes="card" Padding="18"><Grid><TextBlock IsVisible="{Binding !HasSelectedEntry}" Text="Выберите изменение в списке. Если изменений нет, контакты уже согласованы." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="caption"/><Grid IsVisible="{Binding HasSelectedEntry}" RowDefinitions="Auto,Auto,Auto,Auto,*">
            <TextBlock Text="{Binding SelectedEntry.Entry.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{Binding SelectedEntry.Entry.Explanation}" Classes="caption" Margin="0,8"/>
            <WrapPanel Grid.Row="2" IsVisible="{Binding HasSelectedConflict}" Margin="0,4,0,10"><Button Content="Взять из папки" Command="{Binding UseLocalCommand}" AutomationProperties.AutomationId="UseLocalButton" Margin="0,0,6,6"/><Button Content="Взять из Google" Command="{Binding UseGoogleCommand}" AutomationProperties.AutomationId="UseGoogleButton" Margin="0,0,6,6"/><Button Content="Отложить" Command="{Binding SkipCommand}" AutomationProperties.AutomationId="SkipConflictButton" Margin="0,0,6,6"/></WrapPanel>
            <WrapPanel Grid.Row="3" Margin="0,0,0,10"><Button Content="Все поля" Command="{Binding ShowAllFieldsCommand}" Margin="0,0,6,6"/><Button Content="Открыть файл" Command="{Binding OpenFileCommand}" Margin="0,0,6,6"/><Button Content="Показать в папке" Command="{Binding ShowFileCommand}" Margin="0,0,6,6"/></WrapPanel>
            <TextBox Grid.Row="4" Text="{Binding AllFields}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" FontSize="13" AutomationProperties.AutomationId="FieldDetails" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Classes="card" IsVisible="{Binding ShowHistory}"><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="История и восстановление" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding HistoryBackupVolume}" Classes="caption"/><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRun}" MaxHeight="220" AutomationProperties.AutomationId="HistoryList"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="4,10"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Восстановление сначала покажет новый план. Он учитывает текущие файлы и Google; изменения применяются только после просмотра." Classes="caption"/><WrapPanel><Button Content="Подготовить восстановление" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="RestoreButton" Margin="0,0,8,8"/><Button Content="Удалить резервную копию…" Command="{Binding CleanupBackupCommand}" AutomationProperties.AutomationId="CleanupBackupButton" Margin="0,0,0,8"/></WrapPanel><Border Classes="card" IsVisible="{Binding ShowBackupDeleteConfirmation}" Padding="16"><StackPanel Spacing="10"><TextBlock Text="{Binding BackupDeleteWarning}" TextWrapping="Wrap"/><WrapPanel><Button Content="Удалить копию без возможности восстановления" Command="{Binding ConfirmBackupDeleteCommand}" AutomationProperties.AutomationId="ConfirmCleanupBackupButton" Margin="0,0,8,8"/><Button Content="Сохранить копию" Command="{Binding DismissBackupDeleteCommand}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,14,0,0"><TextBlock IsVisible="{Binding HasNotices}" Text="{Binding Notice}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding SelectionSummary}" Classes="caption"/><Button Content="Выбрать безопасные изменения" Command="{Binding SelectSafeCommand}" HorizontalAlignment="Left" Padding="0,6" Background="Transparent" BorderThickness="0"/></StackPanel><Button Grid.Column="1" Content="{Binding ApplyCaption}" Classes="primary" Command="{Binding ApplyCommand}" AutomationProperties.AutomationId="ApplyButton" AutomationProperties.Name="{Binding ApplyCaption}" VerticalAlignment="Center"/></Grid></StackPanel>
      </Grid>
      <Border Classes="card" IsVisible="{Binding ShowDeleteConfirmation}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"><StackPanel Spacing="16"><TextBlock Text="Подтверждение удаления" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap"/><TextBox Text="{Binding DeletePhrase}" PlaceholderText="УДАЛИТЬ — для значительного числа удалений" AutomationProperties.AutomationId="DeletePhraseInput"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Подтвердить удаления" Command="{Binding ConfirmDeletesCommand}" AutomationProperties.AutomationId="ConfirmDeletesButton"/><Button Content="Вернуться к плану" Command="{Binding DismissDeletesCommand}"/></StackPanel></StackPanel></Border>
    </Grid>
    <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" AutomationProperties.Name="{Binding Status}"/><Button Grid.Column="1" Content="Остановить" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" AutomationProperties.AutomationId="CancelButton"/></Grid><Expander Header="Результат каждого действия" IsVisible="{Binding HasResults}" AutomationProperties.AutomationId="ResultsExpander"><ScrollViewer MaxHeight="120"><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander></StackPanel>
  </Grid>
</Window>
