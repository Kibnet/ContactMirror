<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <DefineConstants Condition="'$(ContactMirrorValidationProfile)' == 'Synthetic'">$(DefineConstants);CONTACTMIRROR_VALIDATION</DefineConstants>
    <DefineConstants Condition="'$(ContactMirrorValidationProfile)' == 'Integration'">$(DefineConstants);CONTACTMIRROR_INTEGRATION_VALIDATION</DefineConstants>
  </PropertyGroup>
</Project>
